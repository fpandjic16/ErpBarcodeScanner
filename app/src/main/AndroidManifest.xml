<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- DataWedgeManager.isAvailable looks DataWedge up to decide scanner-or-camera. From
         Android 11 another app's package is invisible without this, and every device would look
         scanner-less. -->
    <queries>
        <package android:name="com.symbol.datawedge" />
    </queries>

    <!-- allowBackup is off: these devices hold every operator’s unsent scans and their
         encrypted ERP credentials, and auto-backup would copy both into whatever Google
         account happens to be on a shared warehouse scanner. The restore could not work
         anyway — the Keystore key behind SecureStore is device-bound and never travels,
         so the restored values would not decrypt. No rule files
         either, so nothing implies otherwise. -->
    <application
        android:name=".BarcodeApplication"
        android:allowBackup="false"
        android:icon="@mipmap/logo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/logo_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.Barcode">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Barcode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>